<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>au.maxschaefer.cache-environment</string>
	<!-- Ghostty opens here, not as a login item, so it and its shells inherit the cache directory. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>/bin/launchctl setenv XDG_CACHE_HOME '{{ .chezmoi.homeDir }}/Library/Caches' &amp;&amp; /usr/bin/open -a Ghostty</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
