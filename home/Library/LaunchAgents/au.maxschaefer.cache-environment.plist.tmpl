<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>au.maxschaefer.cache-environment</string>
	<!-- Apps that start before this runs, such as login items, miss the cache directory. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/launchctl</string>
		<string>setenv</string>
		<string>XDG_CACHE_HOME</string>
		<string>{{ .chezmoi.homeDir }}/Library/Caches</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
