{{- /* chezmoi:modify-template */ -}}
{{- $original := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config := deepCopy $original -}}
{{- range glob (joinPath .chezmoi.homeDir "Projects/*/.git") -}}
{{- $config = setValueAtPath (list "projects" (dir .) "hasTrustDialogAccepted") true $config -}}
{{- end -}}
{{- $key := includeTemplate "bifrost-key" "claude" -}}
{{- range $name, $path := .mcp -}}
{{- $config = setValueAtPath (list "mcpServers" $name "url") (printf "%s%s" $.bifrost.origin $path) $config -}}
{{- $server := index $config "mcpServers" $name -}}
{{- $_ := set $server "type" "http" -}}
{{- $_ := set $server "headers" (dict "x-bf-vk" $key) -}}
{{- end -}}
{{- $config = setValueAtPath (list "mcpServers" "atuin") (dict "type" "stdio" "command" "atuin" "args" (list "mcp")) $config -}}
{{- if deepEqual $original $config -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $config | toPrettyJson -}}
{{- end -}}
