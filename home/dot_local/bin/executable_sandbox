#!/bin/sh
# Open fish in a workspace's smolvm machine, creating it on first use.
# Usage: sandbox WORKSPACE, where WORKSPACE is a group below or a single project in ~/Projects.
# Credentials come from this host's 1Password Connect, served on its tailnet name. The machine gets
# placeholders that smolvm swaps for the Bifrost keys, the GitHub token and the Connect token on
# requests to their hosts. ~/.config/sandbox/WORKSPACE.token selects a workspace's vaults;
# default.token (Automation) serves the rest.
set -eu

workspace=$1
case $workspace in
agents) projects="agents dotfiles" ;;
home-assistant) projects="esphome homeassistant-beszel-integration homeassistant-energy-locals-integration" ;;
infra) projects="flylab homelab kubelab local-services minilab" ;;
*) projects=$workspace ;;
esac

tokens=$HOME/.config/sandbox
connect=$(tailscale status --self --json | jq -r '.Self.DNSName | rtrimstr(".")')
export OP_CONNECT_HOST="https://$connect"
export OP_CONNECT_TOKEN
OP_CONNECT_TOKEN=$(cat "$tokens/default.token")

if ! smolvm machine status --name "$workspace" >/dev/null 2>&1; then
  set --
  for project in $projects; do
    set -- "$@" -v "$HOME/Projects/$project:/root/Projects/$project"
  done
  # The dotfiles set the machine up, so every workspace reads them.
  for project in agents dotfiles; do
    case " $projects " in
    *" $project "*) ;;
    *) set -- "$@" -v "$HOME/Projects/$project:/root/Projects/$project:ro" ;;
    esac
  done
  for agent in CLAUDE CODEX OPENCODE PI; do
    set -- "$@" --secret-env "BIFROST_${agent}_KEY=BIFROST_${agent}_KEY" \
      --credential "bifrost-$agent=BIFROST_${agent}_KEY@bifrost.excloo.com"
  done
  set -- "$@" --secret-env GITHUB_TOKEN=GITHUB_TOKEN \
    --credential "github-api=GITHUB_TOKEN@api.github.com" \
    --credential "github-git=GITHUB_GIT_AUTH@github.com:set-header=authorization" \
    -e "OP_CONNECT_HOST=$OP_CONNECT_HOST" --secret-env OP_CONNECT_TOKEN=WORKSPACE_CONNECT_TOKEN \
    --credential "connect=OP_CONNECT_TOKEN@$connect"
  if [ "$workspace" != infra ]; then
    # Keep the machine off the LAN and tailnet, except for Connect on this host.
    set -- "$@" --allow-private "$(tailscale ip -4)/32"
  fi
  smolvm machine create --name "$workspace" --smolfile "$HOME/.config/smolvm/agent.smolfile" "$@"
fi

if ! smolvm machine status --name "$workspace" | grep -q running; then
  for agent in CLAUDE CODEX OPENCODE PI; do
    export "BIFROST_${agent}_KEY=$(op read "op://Automation/Bifrost Agents/virtual-key-$(echo "$agent" | tr '[:upper:]' '[:lower:]')")"
  done
  GITHUB_TOKEN=$(op read "op://Automation/GitHub Agents/token")
  # Git sends the token as basic auth, which smolvm sets as the whole header for github.com.
  GITHUB_GIT_AUTH="Basic $(printf 'x-access-token:%s' "$GITHUB_TOKEN" | base64 | tr -d '\n')"
  WORKSPACE_CONNECT_TOKEN=$(cat "$tokens/$workspace.token" 2>/dev/null || echo "$OP_CONNECT_TOKEN")
  export GITHUB_TOKEN GITHUB_GIT_AUTH WORKSPACE_CONNECT_TOKEN
  smolvm machine start --name "$workspace"
fi
exec smolvm machine exec --name "$workspace" -it -- fish
