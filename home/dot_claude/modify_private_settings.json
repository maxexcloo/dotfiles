{{- /* chezmoi:modify-template */ -}}
{{- $original := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config := deepCopy $original -}}
{{- $preferences := dict "autoMemoryEnabled" false "enableArtifact" false "outputStyle" "Concise" "spinnerTipsEnabled" false "theme" "auto" "tui" "fullscreen" -}}
{{- $marketplace := dict "source" (dict "source" "directory" "path" (joinPath .chezmoi.workingTree ".." "agents")) -}}
{{- $_ := set $preferences "attribution" (dict "commit" "" "pr" "") -}}
{{- $_ := set $preferences "enabledPlugins" (dict "agents@maxexcloo" true "frontend-design@claude-plugins-official" true) -}}
{{- $_ := set $preferences "env" (dict "DISABLE_AUTOUPDATER" "1") -}}
{{- $_ := set $preferences "extraKnownMarketplaces" (dict "maxexcloo" $marketplace) -}}
{{- $_ := set $preferences "pluginConfigs" (dict "cc-plugin-agents-md@builtin" (dict "options" (dict "instructionFiles" "claude-md-and-agents-md"))) -}}
{{- $config = mergeOverwrite $config $preferences -}}
{{- $config = setValueAtPath (list "permissions" "defaultMode") "auto" $config -}}
{{- $config = setValueAtPath (list "permissions" "blockWritesOutsideWorkingDirectories") true $config -}}
{{- $hooks := get $config "hooks" | default dict -}}
{{- $entries := dict
  "PreToolUse" (dict "matcher" "Bash|Read|Grep" "hooks" (list (dict "type" "command" "command" "$HOME/.agents/hooks/agent-guard pre")))
  "PostToolUse" (dict "matcher" "Bash" "hooks" (list (dict "type" "command" "command" "$HOME/.agents/hooks/agent-guard post claude"))) -}}
{{- /* Keep the guard first: Orca appends its own hooks after it. */ -}}
{{- range $event, $entry := $entries -}}
{{- $kept := list $entry -}}
{{- range get $hooks $event | default list -}}
{{- if not (contains "/.agents/hooks/" (toJson .)) -}}{{- $kept = append $kept . -}}{{- end -}}
{{- end -}}
{{- $_ := set $hooks $event $kept -}}
{{- end -}}
{{- $_ := set $config "hooks" $hooks -}}
{{- if deepEqual $original $config -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $config | toPrettyJson -}}
{{- end -}}
