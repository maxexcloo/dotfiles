{{- /* chezmoi:modify-template */ -}}
{{- $original := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config := deepCopy $original -}}
{{- $preferences := dict "enableArtifact" false "outputStyle" "Concise" "spinnerTipsEnabled" false "theme" "auto" "tui" "fullscreen" -}}
{{- $marketplace := dict "source" (dict "source" "directory" "path" (joinPath .chezmoi.workingTree ".." "agents")) -}}
{{- $_ := set $preferences "attribution" (dict "commit" "" "pr" "") -}}
{{- $_ := set $preferences "enabledPlugins" (dict "agents@maxexcloo" true "frontend-design@claude-plugins-official" true) -}}
{{- $_ := set $preferences "env" (dict "DISABLE_AUTOUPDATER" "1") -}}
{{- $_ := set $preferences "extraKnownMarketplaces" (dict "maxexcloo" $marketplace) -}}
{{- /* Git signing needs the SSH agent outside the sandbox. */ -}}
{{- $_ := set $preferences "sandbox" (dict "allowUnsandboxedCommands" true "enabled" true "excludedCommands" (list "git cherry-pick *" "git commit *" "git merge *" "git rebase *" "git revert *" "git tag *") "failIfUnavailable" true) -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $_ := set $preferences.sandbox "enableWeakerNetworkIsolation" true -}}
{{- $_ := set $preferences.sandbox "filesystem" (dict "allowWrite" (list "~/.local/state" "~/Library/Caches")) -}}
{{- $sockets := list (joinPath (output "getconf" "DARWIN_USER_TEMP_DIR" | trim) (printf "fnox-%s" .chezmoi.uid)) (joinPath .chezmoi.homeDir ".ssh/git-signing.sock") (joinPath .chezmoi.homeDir "Library/Application Support/orca") -}}
{{- $_ := set $preferences.sandbox "network" (dict "allowUnixSockets" $sockets) -}}
{{- else -}}
{{- $_ := set $preferences.sandbox "filesystem" (dict "allowWrite" (list "~/.cache" "~/.local/state")) -}}
{{- $_ := set $preferences.sandbox "network" (dict "allowAllUnixSockets" true) -}}
{{- end -}}
{{- $_ := set $preferences "pluginConfigs" (dict "cc-plugin-agents-md@builtin" (dict "options" (dict "instructionFiles" "claude-md-and-agents-md"))) -}}
{{- $config = mergeOverwrite $config $preferences -}}
{{- $config = setValueAtPath (list "permissions" "defaultMode") "auto" $config -}}
{{- $_ := set $config "hooks" (includeTemplate "agent-guard-hooks" (dict "hooks" (get $config "hooks") "pre" "Bash|Read|Grep" "agent" "claude") | fromJson) -}}
{{- if deepEqual $original $config -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $config | toPrettyJson -}}
{{- end -}}
