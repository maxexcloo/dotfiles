name: browserless
services:
  browserless:
    image: ghcr.io/browserless/chromium:{{ .services.browserless.version }}
    restart: unless-stopped
    shm_size: 1gb
    environment:
      CONCURRENT: 4
      QUEUED: 4
      TIMEOUT: 3600000
    ports:
      - "127.0.0.1:{{ .services.browserless.port }}:3000"
