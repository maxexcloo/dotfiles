[Container]
Environment=CONCURRENT={{ .services.browserless.concurrent }}
Environment=QUEUED={{ .services.browserless.queued }}
Environment=TIMEOUT={{ .services.browserless.timeout }}
Image=ghcr.io/browserless/chromium:{{ .services.browserless.version }}
PublishPort=127.0.0.1:{{ .services.browserless.port }}:3000
ShmSize=1g

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
