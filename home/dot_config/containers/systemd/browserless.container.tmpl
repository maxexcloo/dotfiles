{{- $browserless := .services.browserless -}}
[Unit]
Description=Browser Automation

[Container]
ContainerName=browserless
Image={{ $browserless.image }}:{{ $browserless.version }}
{{- range $name, $value := $browserless.environment }}
Environment={{ $name }}={{ $value }}
{{- end }}
Environment=PORT={{ $browserless.port }}
Network=host
ShmSize={{ $browserless.shmSize }}

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
