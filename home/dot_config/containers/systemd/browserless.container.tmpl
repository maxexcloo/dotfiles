{{- $service := index (includeTemplate "homelab-services" . | fromJson) "agent-browser" -}}
[Unit]
Description=Browser Automation

[Container]
ContainerName=browserless
Image=ghcr.io/browserless/chromium:{{ .services.browserless.version }}
Environment=CONCURRENT=4
Environment=HOST=127.0.0.1
Environment=PORT={{ $service.browser_upstream | splitList ":" | last }}
Environment=QUEUED=4
Environment=TIMEOUT=3600000
Network=host
ShmSize=1g

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
