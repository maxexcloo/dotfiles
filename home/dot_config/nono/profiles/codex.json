{
  "extends": "nolabs-ai/codex",
  "meta": { "name": "codex" },
  "groups": { "include": ["mise_manager"] },
  "filesystem": { "read": ["$HOME/.agents", "$HOME/Projects/agents"] },
  "env_credentials": {
    "env://OP_CONNECT_TOKEN": "OP_CONNECT_TOKEN",
    "op://Automation/Bifrost Agents/virtual-key-codex": "BIFROST_CODEX_KEY",
    "op://Automation/GitHub Agents/token": "GH_TOKEN"
  }
}
