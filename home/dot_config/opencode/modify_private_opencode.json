{{- /* chezmoi:modify-template */ -}}
{{- $original := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config := deepCopy $original -}}
{{- $preferences := dict "$schema" "https://opencode.ai/config.json" "formatter" true "update" "disable" -}}
{{- $config = mergeOverwrite $config $preferences -}}
{{- range $name, $server := .mcp -}}
{{- $config = setValueAtPath (list "mcp" "servers" $name "oauth") false $config -}}
{{- $config = setValueAtPath (list "mcp" "servers" $name "type") "remote" $config -}}
{{- $config = setValueAtPath (list "mcp" "servers" $name "url") $server.url $config -}}
{{- $server := index $config "mcp" "servers" $name -}}
{{- $_ := set $server "headers" (dict "Authorization" "Bearer {env:BIFROST_OPENCODE_KEY}") -}}
{{- end -}}
{{- $capabilities := dict "input" (list "text" "image") "output" (list "text") "reasoning" (dict "supported" true) "tools" true -}}
{{- $text := .bifrost.textModel -}}
{{- $model := dict "name" $text.name "capabilities" $capabilities "limit" (dict "context" $text.contextWindow "output" $text.maxTokens) -}}
{{- $settings := dict "apiKey" "{env:BIFROST_OPENCODE_KEY}" "baseURL" .bifrost.baseUrl -}}
{{- $bifrost := dict "name" "Bifrost" "package" "aisdk:@ai-sdk/openai-compatible" "settings" $settings "models" (dict $text.id $model) -}}
{{- $config = setValueAtPath (list "providers" "bifrost") $bifrost $config -}}
{{- if deepEqual $original $config -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $config | toPrettyJson -}}
{{- end -}}
