{{- /* chezmoi:modify-template */ -}}
{{- $original := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config := deepCopy $original -}}
{{- $preferences := dict "$schema" "https://opencode.ai/config.json" "formatter" true "update" "disable" -}}
{{- $config = mergeOverwrite $config $preferences -}}
{{- $permissions := list (dict "action" "external_directory" "effect" "ask" "resource" "*") (dict "action" "shell" "effect" "ask" "resource" "*") -}}
{{- $_ := set $config "permissions" (concat $permissions (get $config "permissions" | default list) | uniq) -}}
{{- $key := includeTemplate "bifrost-key" "opencode" -}}
{{- range $name, $server := .mcp -}}
{{- $config = setValueAtPath (list "mcp" "servers" $name "oauth") false $config -}}
{{- $config = setValueAtPath (list "mcp" "servers" $name "type") "remote" $config -}}
{{- $config = setValueAtPath (list "mcp" "servers" $name "url") $server.url $config -}}
{{- /* Bifrost's Code Mode owns tool discovery; OpenCode's own Code Mode would wrap
its meta-tools in a second interpreter. */ -}}
{{- $config = setValueAtPath (list "mcp" "servers" $name "codemode") false $config -}}
{{- $server := index $config "mcp" "servers" $name -}}
{{- $_ := set $server "headers" (dict "Authorization" (printf "Bearer %s" $key)) -}}
{{- end -}}
{{- $settings := dict "apiKey" $key "baseURL" .bifrost.baseUrl -}}
{{- $bifrost := dict "name" "Bifrost" "package" "aisdk:@ai-sdk/openai-compatible" "settings" $settings -}}
{{- $config = setValueAtPath (list "providers" "bifrost") $bifrost $config -}}
{{- if deepEqual $original $config -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $config | toPrettyJson -}}
{{- end -}}
