{{- /* chezmoi:modify-template */ -}}
{{- $original := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config := deepCopy $original -}}
{{- $preferences := dict "$schema" "https://opencode.ai/config.json" "formatter" true "update" "disable" -}}
{{- $config = mergeOverwrite $config $preferences -}}
{{- range $name, $server := .mcp -}}
{{- $config = setValueAtPath (list "mcp" $name "oauth") false $config -}}
{{- $config = setValueAtPath (list "mcp" $name "type") "remote" $config -}}
{{- $config = setValueAtPath (list "mcp" $name "url") $server.url $config -}}
{{- $server := index $config "mcp" $name -}}
{{- $_ := set $server "headers" (dict "Authorization" "Bearer {env:BIFROST_OPENCODE_KEY}") -}}
{{- end -}}
{{- $bifrost := dict "name" "Bifrost" "npm" "@ai-sdk/openai-compatible" "options" (dict "baseURL" "https://bifrost.excloo.com/v1" "apiKey" "{env:BIFROST_OPENCODE_KEY}") -}}
{{- $config = setValueAtPath (list "provider" "bifrost") $bifrost $config -}}
{{- if deepEqual $original $config -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $config | toPrettyJson -}}
{{- end -}}
