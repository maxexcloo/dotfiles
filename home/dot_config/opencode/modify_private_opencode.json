{{- /* chezmoi:modify-template */ -}}
{{- $original := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config := deepCopy $original -}}
{{- $preferences := includeTemplate "opencode.json" . | fromJson -}}
{{- $config = mergeOverwrite $config $preferences -}}
{{- $config = unset $config "autoupdate" -}}
{{- range $name, $server := .mcp -}}
{{- $config = setValueAtPath (list "mcp" $name "oauth") false $config -}}
{{- $config = setValueAtPath (list "mcp" $name "type") "remote" $config -}}
{{- $config = setValueAtPath (list "mcp" $name "url") $server.url $config -}}
{{- end -}}
{{- range $name, $server := (get $config "mcp" | default dict) -}}
{{-   if contains "litellm.excloo.com" (get $server "url" | default "") -}}
{{-     $_ := set $server "headers" (dict "Authorization" "Bearer {env:LITELLM_OPENCODE_KEY}") -}}
{{-   end -}}
{{- end -}}
{{- if deepEqual $original $config -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $config | toPrettyJson -}}
{{- end -}}
