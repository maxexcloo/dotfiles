import { Model, Plugin, Provider } from "@opencode/plugin";

const apiKey = {{ includeTemplate "bifrost-key" "opencode" | toJson }};
const baseURL = {{ printf "%s%s" .bifrost.origin .bifrost.inferencePath | toJson }};
const providerID = Provider.ID.make("bifrost");
const hidden = /^({{ join "|" .bifrost.hiddenProviders }})\//;
const context = (entry) =>
  entry.context_length ?? (entry.id.startsWith("local/") ? 262144 : 1048576);
// Bifrost prices in USD per token; OpenCode prices in USD per million tokens.
const perMillion = (value) => Number(value) * 1_000_000;
const cost = (entry) =>
  entry.pricing
    ? [
        {
          input: perMillion(entry.pricing.prompt ?? 0),
          output: perMillion(entry.pricing.completion ?? 0),
          cache: {
            read: perMillion(entry.pricing.input_cache_read ?? 0),
            write: perMillion(entry.pricing.input_cache_write ?? 0),
          },
        },
      ]
    : [];

const load = async () => {
  const response = await fetch(`${baseURL}/models`, {
    headers: { Authorization: `Bearer ${apiKey}` },
  });
  if (!response.ok) throw new Error(`bifrost models: ${response.status}`);
  const { data } = await response.json();
  return data
    .filter((entry) => !hidden.test(entry.id))
    .map((entry) => {
      const model = Model.Info.default(providerID, Model.ID.make(entry.id));
      return {
        ...model,
        name: entry.id,
        cost: cost(entry),
        limit: { ...model.limit, context: context(entry) },
      };
    });
};

export default Plugin.define({
  id: "bifrost-models",
  setup: async (ctx) => {
    const source = { models: [] };
    let registered = false;
    const refresh = async () => {
      source.models = await load();
      if (registered) return ctx.provider.reload();
      await ctx.provider.transform((editor) => editor.models.set("bifrost", source.models));
      registered = true;
    };
    await refresh().catch(console.error);
    const timer = setInterval(() => void refresh().catch(console.error), 300_000);
    return () => clearInterval(timer);
  },
});
