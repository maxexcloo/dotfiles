[daemon]
enabled = true

# On Linux, the 1Password CLI reads the vault through the host's Connect server.
[providers.automation]
type = "1password"
vault = "Automation"
{{- if eq .chezmoi.os "darwin" }}
token = { secret = "OP_AUTOMATION_TOKEN" }

[providers.keychain]
service = "fnox"
type = "keychain"
{{- end }}

[secrets]
{{- if eq .chezmoi.os "darwin" }}
# Not named OP_SERVICE_ACCOUNT_TOKEN: fnox hands that name to every 1Password provider, so project configs would sign
# in as this Automation-only account instead of through the desktop app.
OP_AUTOMATION_TOKEN = { env = false, provider = "keychain", value = "op-service-account-automation" }
{{- end }}
# Bifrost virtual keys for the agents' MCP access; copies of 1Password "Bifrost" (Kubelab SYD), update both together.
BIFROST_CLAUDE_KEY = { env = false, provider = "automation", value = "Bifrost Agents/virtual-key-claude" }
BIFROST_CODEX_KEY = { env = false, provider = "automation", value = "Bifrost Agents/virtual-key-codex" }
BIFROST_OPENCODE_KEY = { env = false, provider = "automation", value = "Bifrost Agents/virtual-key-opencode" }
BIFROST_PI_KEY = { env = false, provider = "automation", value = "Bifrost Agents/virtual-key-pi" }
# Lets sandboxed agents push over HTTPS, as they cannot use 1Password commit signing.
GH_TOKEN = { env = false, provider = "automation", value = "GitHub Agents/token" }
