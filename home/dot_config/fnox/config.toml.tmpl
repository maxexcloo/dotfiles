{{- $linux := eq .chezmoi.os "linux" -}}
{{- if $linux -}}
# Linux hosts have no 1Password app: a service account signs in, its token kept in this unmanaged file.
import = ["service-account.toml"]

{{ end -}}
[daemon]
enabled = true

[providers.automation]
type = "1password"
vault = "Automation"
{{- if $linux }}
token = { secret = "OP_SERVICE_ACCOUNT_TOKEN" }
{{- end }}

[providers.homelab]
type = "1password"
vault = "Homelab"
{{- if $linux }}
token = { secret = "OP_SERVICE_ACCOUNT_TOKEN" }
{{- end }}

[providers.kubelab-syd]
type = "1password"
vault = "Kubelab SYD"
{{- if $linux }}
token = { secret = "OP_SERVICE_ACCOUNT_TOKEN" }
{{- end }}

[secrets]
# Bifrost virtual keys for the agents' MCP access; copies of 1Password "Bifrost" (Kubelab SYD), update both together.
BIFROST_CLAUDE_KEY = { env = false, provider = "automation", value = "Bifrost Agents/virtual-key-claude" }
BIFROST_CODEX_KEY = { env = false, provider = "automation", value = "Bifrost Agents/virtual-key-codex" }
BIFROST_DSH_KEY = { env = "exec", provider = "automation", value = "Bifrost Agents/virtual-key-dsh" }
BIFROST_OPENCODE_KEY = { env = false, provider = "automation", value = "Bifrost Agents/virtual-key-opencode" }
BIFROST_PI_KEY = { env = false, provider = "automation", value = "Bifrost Agents/virtual-key-pi" }
{{- if $linux }}
BROWSERLESS_TOKEN = { env = "exec", provider = "automation", value = "Browserless/{{ .chezmoi.hostname }}" }
{{- end }}
GIT_SIGNING_KEY = { env = false, provider = "automation", value = "Signing Key/private key?ssh-format=openssh" }

# This host's Connect server token, for projects that select the profile; op:// rejects ':' in titles, so these are item IDs.
[profiles.connect.secrets]
{{- if $linux }}
# "Connect Token: mercury.mbk.excloo.net"
OP_CONNECT_TOKEN = { provider = "homelab", value = "7ulpapdlecoyo4giire5kaddkq/credential" }
{{- else }}
# "Connect Token: macbook-pro.mbk.excloo.net"
OP_CONNECT_TOKEN = { provider = "homelab", value = "zkkyb66yspbl563pwdlaem4mky/credential" }
{{- end }}
