- id: llm-pi-ai
  config:
    providers:
      bifrost:
        api: openai-completions
        apiKeyEnv: BIFROST_DSH_KEY
        baseURL: {{ printf "%s%s" .bifrost.origin .bifrost.inferencePath }}
        displayName: Bifrost
        models:
          - id: cloud/auto
            compat:
              supportsDeveloperRole: false
              thinkingFormat: deepseek
          - id: local/auto
