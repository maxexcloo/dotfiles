# A machine for coding agents, set up from these dotfiles like the workstation. Based on smolvm's
# coding-agent Smolfile; `sandbox` adds each workspace's projects and credentials.
image = "debian:trixie-slim"
net = true

# Claude Code skips permissions as root only when it knows it is sandboxed.
env = ["IS_SANDBOX=1"]

[dev]
workdir = "/root/Projects"
init = [
  "apt-get update -qq && apt-get install -yqq ca-certificates curl fish git libatomic1 >/dev/null",
  # The projects belong to the host user; git refuses them as root without this.
  "git config --system --add safe.directory '*'",
  "curl -fsSL https://mise.run | sh",
  "/root/.local/bin/mise exec chezmoi@latest -- chezmoi init --apply --source /root/Projects/dotfiles",
  # mise 2026.11.4 fails installing fnox while fetching a skill file that does not exist.
  "MISE_SKILLS_FETCH=false /root/.local/bin/mise install",
  "chsh -s /usr/bin/fish",
]
