{{- $services := includeTemplate "homelab-services" . | fromJson -}}
{{- $routers := dict -}}
{{- $backends := dict -}}
{{- $transports := dict -}}
{{- range $name, $runtime := .services -}}
{{- if and (hasKey $runtime "port") (hasKey $services $name) -}}
{{- $service := index $services $name -}}
{{- if eq $service.scheme "https" -}}
{{- $_ := set $routers $name (dict "entryPoints" (list "websecure") "rule" (printf "Host(`%s`)" $service.hostname) "service" $name "tls" (dict "certResolver" "cloudflare")) -}}
{{- $backend := dict "servers" (list (dict "url" (printf "%s://127.0.0.1:%v" $runtime.scheme $runtime.port))) -}}
{{- if eq $name "syncthing" -}}
{{- $_ := set $backend "passHostHeader" false -}}
{{- end -}}
{{- if eq $name "dsh" -}}
{{- $_ := set $backend "serversTransport" "dsh" -}}
{{- $_ := set $transports "dsh" (dict "serverName" "localhost" "rootCAs" (list "/etc/traefik-dsh.crt")) -}}
{{- end -}}
{{- $_ := set $backends $name (dict "loadBalancer" $backend) -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{ dict "http" (dict "routers" $routers "services" $backends "serversTransports" $transports) | toYaml -}}
