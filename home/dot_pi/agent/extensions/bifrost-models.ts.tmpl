// Bifrost owns the catalogue. These prefixes are hidden because the client
// reaches them natively, or because they duplicate another Bifrost provider.
const baseUrl = {{ .bifrost.baseUrl | toJson }};
// Pi signs in to OpenCode once for both Go and Zen, so it keeps those aliases.
// Its OpenAI sign-in covers the cliproxy-openai channel; the anthropic, google
// and grok channels are the only way in, so they stay.
const hidden = /^(deepseek|openrouter|cliproxy-openai)\//;
const contextWindow = (entry: { id: string; context_length?: number }) =>
  entry.context_length ?? (entry.id.startsWith("local/") ? 262144 : 1048576);
// Bifrost prices in USD per token; Pi prices in USD per million tokens.
const perMillion = (value?: string) => Number(value ?? 0) * 1_000_000;
const cost = (entry: { pricing?: Record<string, string> }) => ({
  input: perMillion(entry.pricing?.prompt),
  output: perMillion(entry.pricing?.completion),
  cacheRead: perMillion(entry.pricing?.input_cache_read),
  cacheWrite: perMillion(entry.pricing?.input_cache_write),
});

const load = async (signal?: AbortSignal) => {
  const response = await fetch(`${baseUrl}/models`, {
    headers: { Authorization: `Bearer ${process.env.BIFROST_PI_KEY ?? ""}` },
    signal,
  });
  if (!response.ok) throw new Error(`bifrost models: ${response.status}`);
  const { data } = await response.json();
  return data
    .filter((entry: { id: string }) => !hidden.test(entry.id))
    .map((entry: { id: string; context_length?: number; pricing?: Record<string, string> }) => ({
      type: "chat" as const,
      id: entry.id,
      name: entry.id,
      reasoning: true,
      input: ["text", "image"] as ("text" | "image")[],
      cost: cost(entry),
      contextWindow: contextWindow(entry),
      maxTokens: 65536,
    }));
};

export default function (pi) {
  pi.registerProvider("bifrost", {
    name: "Bifrost",
    baseUrl,
    apiKey: "$BIFROST_PI_KEY",
    api: "openai-completions",
    refreshModels: async (refresh?: { signal?: AbortSignal }) => load(refresh?.signal),
  });
}
