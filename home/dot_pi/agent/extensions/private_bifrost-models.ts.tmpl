const apiKey = {{ includeTemplate "bifrost-key" "pi" | toJson }};
const baseUrl = {{ printf "%s%s" .bifrost.origin .bifrost.inferencePath | toJson }};
const hidden = /^({{ join "|" .bifrost.hiddenProviders }})\//;
type CatalogueModel = {
  id: string;
  name?: string;
  context_length?: number;
  max_output_tokens?: number;
  pricing?: Record<string, string>;
};
const contextWindow = (entry: { id: string; context_length?: number }) =>
  entry.context_length ?? (entry.id.startsWith("local/") ? {{ .bifrost.localContext }} : {{ .bifrost.defaultContext }});
// Bifrost prices in USD per token; Pi prices in USD per million tokens.
const perMillion = (value?: string) => Number(value ?? 0) * 1_000_000;
const cost = (entry: { pricing?: Record<string, string> }) => ({
  input: perMillion(entry.pricing?.prompt),
  output: perMillion(entry.pricing?.completion),
  cacheRead: perMillion(entry.pricing?.input_cache_read),
  cacheWrite: perMillion(entry.pricing?.input_cache_write),
});

const load = async (signal: AbortSignal) => {
  const response = await fetch(`${baseUrl}/models`, {
    headers: { Authorization: `Bearer ${apiKey}` },
    signal,
  });
  if (!response.ok) throw new Error(`bifrost models: ${response.status}`);
  const { data }: { data: CatalogueModel[] } = await response.json();
  return data
    .filter((entry) => !hidden.test(entry.id))
    .map((entry) => ({
      type: "chat" as const,
      id: entry.id,
      name: entry.name ?? entry.id,
      reasoning: true,
      input: ["text", "image"] as ("text" | "image")[],
      cost: cost(entry),
      contextWindow: contextWindow(entry),
      maxTokens: entry.max_output_tokens ?? 65536,
    }));
};

export default async function (pi) {
  let models =
    process.env.PI_OFFLINE === "1"
      ? []
      : await load(AbortSignal.timeout(5000)).catch((error) => {
          console.error(error);
          return [];
        });
  pi.registerProvider("bifrost", {
    name: "Bifrost",
    baseUrl,
    apiKey,
    api: "openai-completions",
    models,
    async refreshModels({ allowNetwork, signal }: { allowNetwork: boolean; signal: AbortSignal }) {
      if (allowNetwork) {
        const refreshed = await load(signal);
        signal.throwIfAborted();
        models = refreshed;
      }
      return models;
    },
  });
}
