{{- /* chezmoi:modify-template */ -}}
{{- $original := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config := deepCopy $original -}}
{{- $key := includeTemplate "bifrost-key" "pi" -}}
{{- range $name, $managed := .mcp -}}
{{- $config = setValueAtPath (list "mcpServers" $name "url") $managed.url $config -}}
{{- $server := index $config "mcpServers" $name -}}
{{- $_ := set $server "headers" (dict "Authorization" (printf "Bearer %s" $key)) -}}
{{- /* Per-request cap covers the connect, so a downed endpoint fails in seconds instead of 60.
It also bounds tool calls, hence 15s rather than the 60s default. */ -}}
{{- $_ := set $server "timeout" 15 -}}
{{- end -}}
{{- $config = setValueAtPath (list "mcpServers" "atuin") (dict "command" "atuin" "args" (list "mcp")) $config -}}
{{- if deepEqual $original $config -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $config | toPrettyJson -}}
{{- end -}}
