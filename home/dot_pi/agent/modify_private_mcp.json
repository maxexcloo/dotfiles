{{- /* chezmoi:modify-template */ -}}
{{- /* pi fetches its LiteLLM key when it connects instead of storing it in the header. */ -}}
{{- $original := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config := deepCopy $original -}}
{{- range $name, $server := (get $config "mcpServers" | default dict) -}}
{{-   if contains "litellm.excloo.com" (get $server "url" | default "") -}}
{{-     $_ := set $server "headers" (dict "Authorization" "!echo Bearer $(fnox get LITELLM_PI_KEY)") -}}
{{-   end -}}
{{- end -}}
{{- if deepEqual $original $config -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $config | toPrettyJson -}}
{{- end -}}
