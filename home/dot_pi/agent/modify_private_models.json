{{- /* chezmoi:modify-template */ -}}
{{- $original := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config := deepCopy $original -}}
{{- $provider := dict "baseUrl" .bifrost.baseUrl "api" "openai-completions" "apiKey" "${BIFROST_PI_KEY}" -}}
{{- $config = setValueAtPath (list "providers" "bifrost") $provider $config -}}
{{- $config = setValueAtPath (list "providers" "openrouter" "models") (list) $config -}}
{{- if deepEqual $original $config -}}
{{ .chezmoi.stdin -}}
{{- else -}}
{{ $config | toPrettyJson -}}
{{- end -}}
