{{- /* chezmoi:modify-template */ -}}
{{- $config := .chezmoi.stdin | default "{}" | fromJson -}}
{{- $config = omit $config "cdpHeaders" "executablePath" -}}
{{- $_ := set $config "cdp" (printf "ws://%s:%v/chromium" .services.browserless.environment.HOST .services.browserless.port) -}}
{{- $config | toPrettyJson -}}
