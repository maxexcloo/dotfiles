{{- /* chezmoi:modify-template */ -}}
{{- $config := .chezmoi.stdin | default "{}" | fromJson -}}
{{- if eq .chezmoi.os "darwin" -}}
{{- $config = omit $config "cdp" "cdpHeaders" -}}
{{- $_ := set $config "executablePath" "/Applications/Chromium.app/Contents/MacOS/Chromium" -}}
{{- else -}}
{{- $config = omit $config "cdpHeaders" "executablePath" -}}
{{- $_ := set $config "cdp" (printf "ws://127.0.0.1:%v/chromium" .services.browserless.port) -}}
{{- end -}}
{{- $config | toPrettyJson -}}
