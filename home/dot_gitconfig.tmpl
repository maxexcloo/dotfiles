[fetch]
prune = true

[push]
autoSetupRemote = true

[rebase]
autoStash = true

[rerere]
enabled = true

[user]
email = max@excloo.com
name = Max Schaefer
signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIaF+DCJq1CyGrafKzDMtNjW02M5XJoH5MLFFSlHPjyz

[hook "gitleaks"]
command = gitleaks git --pre-commit --staged --redact --no-banner --log-level warn
event = pre-commit
{{- if eq .chezmoi.os "darwin" }}

[commit]
gpgsign = true

[gpg]
format = ssh

[gpg "ssh"]
program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[url "git@github.com:"]
insteadOf = https://github.com/
{{- else }}

# Sandboxed agents have no 1Password app; they commit unsigned and push with the GH_TOKEN their profile adds.
[credential "https://github.com"]
helper = !gh auth git-credential
{{- end }}
