[fetch]
prune = true

[push]
autoSetupRemote = true

[rebase]
autoStash = true

[rerere]
enabled = true

[user]
email = max@excloo.com
name = Max Schaefer
signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIaF+DCJq1CyGrafKzDMtNjW02M5XJoH5MLFFSlHPjyz

[hook "gitleaks"]
command = gitleaks git --pre-commit --staged --redact --no-banner --log-level warn
event = pre-commit
{{- if eq .chezmoi.os "darwin" }}

# Sandbox machines have no 1Password; they commit unsigned and push over HTTPS with an injected token.
[commit]
gpgsign = true

[gpg]
format = ssh

[gpg "ssh"]
program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

[url "git@github.com:"]
insteadOf = https://github.com/
{{- end }}
