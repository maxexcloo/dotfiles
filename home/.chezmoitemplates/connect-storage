Secret=onepassword-connect-credentials,target=/home/opuser/.op/1password-credentials.json,uid=999,mode=0400
Volume=onepassword-connect:/home/opuser/.op/data

[Service]
ExecStartPre=/usr/bin/podman volume exists onepassword-connect
# Root's user podman-restart.service stops all rootful containers when a sudo session ends.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
