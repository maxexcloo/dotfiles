{
  "extends": "nolabs-ai/{{ .agent }}",
  "env_credentials": {
    "env://BIFROST_{{ upper .agent }}_KEY": "BIFROST_{{ upper .agent }}_KEY",
    "env://GH_TOKEN": "GH_TOKEN",
    "env://OP_CONNECT_TOKEN": "OP_CONNECT_TOKEN"
  },
  "environment": { "set_vars": { "GIT_CONFIG_GLOBAL": "$HOME/.config/git/config" } },
  "filesystem": { "read": ["$HOME/.agents", "$HOME/Projects/agents"] },
  "groups": { "include": ["mise_manager"] },
  "meta": { "name": "{{ .agent }}" }
}
