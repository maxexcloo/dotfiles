{{- if not (hasPrefix "op://" .credentialReference) -}}
{{- fail "MCP credentials require an op:// reference in home/.chezmoidata.toml" -}}
{{- end -}}
{{- $token := onepasswordRead .credentialReference | trim -}}
{{- if eq $token "" -}}{{- fail "The MCP credential is empty" -}}{{- end -}}
{{- if not (hasPrefix "Bearer " $token) -}}
{{- $token = printf "Bearer %s" $token -}}
{{- end -}}
{{- $headers := dict -}}
{{- range $name, $server := .mcp -}}
{{- $_ := set $headers $name (dict "Authorization" $token) -}}
{{- end -}}
{{- $headers | toJson -}}
