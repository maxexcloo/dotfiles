{{- $hooks := .hooks | default dict -}}
{{- $guard := "$HOME/.agents/hooks/secret-guard" -}}
{{- $entries := dict
  "PreToolUse" (dict "matcher" .pre "hooks" (list (dict "type" "command" "command" (printf "%s pre" $guard))))
  "PostToolUse" (dict "matcher" "Bash" "hooks" (list (dict "type" "command" "command" (printf "%s post %s" $guard .agent)))) -}}
{{- range $event, $entry := $entries -}}
{{-   $kept := list -}}
{{-   range get $hooks $event | default list -}}
{{-     if not (contains "secret-guard" (toJson .)) -}}{{- $kept = append $kept . -}}{{- end -}}
{{-   end -}}
{{-   $_ := set $hooks $event (append $kept $entry) -}}
{{- end -}}
{{- $hooks | toJson -}}
