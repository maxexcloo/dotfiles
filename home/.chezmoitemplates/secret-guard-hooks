{{- $hooks := .hooks | default dict -}}
{{- $guard := "$HOME/.agents/hooks/secret-guard" -}}
{{- $entries := dict
  "PreToolUse" (dict "matcher" .pre "hooks" (list (dict "type" "command" "command" (printf "%s pre" $guard))))
  "PostToolUse" (dict "matcher" "Bash" "hooks" (list (dict "type" "command" "command" (printf "%s post %s" $guard .agent)))) -}}
{{- range $event, $entry := $entries -}}
{{-   $kept := list -}}
{{-   $placed := false -}}
{{- /* Replace the guard where it is: Orca re-appends its own hooks, so moving ours to the end never settles. */ -}}
{{-   range get $hooks $event | default list -}}
{{-     if not (contains "secret-guard" (toJson .)) -}}{{- $kept = append $kept . -}}
{{-     else if not $placed -}}{{- $kept = append $kept $entry -}}{{- $placed = true -}}
{{-     end -}}
{{-   end -}}
{{-   if not $placed -}}{{- $kept = append $kept $entry -}}{{- end -}}
{{-   $_ := set $hooks $event $kept -}}
{{- end -}}
{{- $hooks | toJson -}}
