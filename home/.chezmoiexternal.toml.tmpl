# renovate: datasource=github-releases depName=vercel-labs/agent-browser
{{- $agentBrowser := "https://raw.githubusercontent.com/vercel-labs/agent-browser/v0.44.0" }}
[".agents/skills/agent-browser/LICENSE"]
type = "file"
url = "{{ $agentBrowser }}/LICENSE"

[".agents/skills/agent-browser/SKILL.md"]
type = "file"
url = "{{ $agentBrowser }}/skills/agent-browser/SKILL.md"

[".agents/skills/humanizer"]
type = "archive"
exact = true
stripComponents = 1
# renovate: datasource=github-releases depName=blader/humanizer
url = "https://github.com/blader/humanizer/archive/refs/tags/v4.0.0.tar.gz"
include = ["*/LICENSE", "*/README.md", "*/SKILL.md"]

# Orca's own skills (orca-cli, orchestration) are installed by Orca itself, which
# keeps them matched to the binary on each host; see .chezmoiscripts.
[".agents/skills/terrashark"]
type = "archive"
exact = true
stripComponents = 1
# renovate: datasource=git-refs depName=https://github.com/LukasNiessen/terrashark
url = "https://github.com/LukasNiessen/terrashark/archive/21f2c18b912818b6a8e2b7bdbf25a275ecb894b1.tar.gz"
include = ["*/LICENSE", "*/README.md", "*/SKILL.md", "*/references/**"]
