#!/bin/bash
# Agent hook that blocks secret-revealing tool calls and redacts secrets from output.
#   pre           Claude Code or Codex PreToolUse JSON on stdin; exit 2 blocks the call
#   post claude   Claude Code PostToolUse JSON on stdin; replaces output that held a secret
#   post codex    Codex PostToolUse JSON on stdin; replaces output that held a secret
#   redact        plain text on stdin; prints it with secrets replaced
set -euo pipefail

blocked='\bop (read|inject)\b|\bop item get\b.*--(reveal|fields)|\bfnox get\b|(^|[;&|[:space:]])printenv\b|(^|[;&|][[:space:]]*)env[[:space:]]*($|[;&|>])|security find-(generic|internet)-password.*-w|\.env($|[^.[:alnum:]_-]|\.)|secrets\.yaml|auth\.json|\.config/op/|rclone\.conf|\.kube/config|\.talos/config'

redact() {
  local text secrets
  text=$(cat)
  secrets=$(gitleaks stdin --no-banner --log-level error --exit-code 0 --report-format json --report-path - <<<"$text" 2>/dev/null | jq -c '[.[].Secret] | unique')
  if [ "$secrets" = "[]" ]; then printf '%s' "$text"; return 1; fi
  { printf '%s\n' "$secrets"; jq -Rs . <<<"$text"; } | jq -rs 2>/dev/null '.[0] as $s | reduce $s[] as $x (.[1]; split($x) | join("[REDACTED]"))'
}

input=$(cat)
case "${1:-}" in
  pre)
    target=$(jq -r '.tool_input | .command // .file_path // .filePath // .path // empty' <<<"$input" | sed 's/\.env\.example//g')
    if grep -qE "$blocked" <<<"$target"; then
      echo "Blocked by secret-guard: this would expose a secret. Use fnox exec or op run, or ask the user to run it." >&2
      exit 2
    fi
    ;;
  post)
    output=$(jq -r '.tool_response | if type == "object" then [.stdout, .stderr, .output] | map(select(. != null and . != "")) | join("\n") else tostring end' <<<"$input")
    clean=$(redact <<<"$output") || exit 0
    note="secret-guard redacted a secret from this output; tell the user to rotate it."
    # shellcheck disable=SC2016 # jq variables, not shell
    case "${2:-}" in
      claude) filter='{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $note, updatedToolOutput: (.[1].tool_response | .stdout = $out | .stderr = "")}}' ;;
      codex) filter='{decision: "block", reason: ($note + "\n\n" + $out)}' ;;
      *) echo "usage: secret-guard post claude|codex" >&2; exit 64 ;;
    esac
    { jq -Rs . <<<"$clean"; printf '%s' "$input"; } | jq -cs --arg note "$note" ".[0] as \$out | $filter"
    ;;
  redact) redact <<<"$input" || true ;;
  *) echo "usage: secret-guard pre | post claude|codex | redact" >&2; exit 64 ;;
esac
